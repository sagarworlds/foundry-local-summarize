<Project Sdk="Microsoft.NET.Sdk">

  <!-- View models and the UI-facing service interfaces. Deliberately free of WPF, so the screen logic can be
       unit-tested on any platform; the WPF project supplies the views and the platform services. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FoundrySummarizer.Core\FoundrySummarizer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>

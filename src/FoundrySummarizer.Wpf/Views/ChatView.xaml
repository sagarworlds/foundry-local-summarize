<UserControl x:Class="FoundrySummarizer.Wpf.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:FoundrySummarizer.Wpf.Converters"
             xmlns:vm="clr-namespace:FoundrySummarizer.Presentation.ViewModels;assembly=FoundrySummarizer.Presentation"
             mc:Ignorable="d" d:DesignHeight="650" d:DesignWidth="1080">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button Content="🗑 Clear Conversation" Style="{StaticResource SecondaryButton}" Command="{Binding ClearChatCommand}"
                    DockPanel.Dock="Right" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="Follow-up Questions" Style="{StaticResource HeadingLarge}" />
                <TextBlock Text="{Binding DocumentName, StringFormat='About: {0}'}" Style="{StaticResource BodyText}" Margin="0,4,0,0"
                           Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DockPanel>

        <!-- Suggested questions, written by the model for this document after it is summarized -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <ProgressBar IsIndeterminate="True" Width="50" Height="4" Margin="0,0,8,0" VerticalAlignment="Center"
                             Foreground="{StaticResource AccentPrimaryBrush}" Background="{StaticResource BorderBrush}"
                             Visibility="{Binding IsSuggesting, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding SuggestionsStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding SuggestedQuestions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,6"
                                Command="{Binding DataContext.AskSuggestedQuestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Conversation -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,0,0,12">
            <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <!-- Plain containers: no selection highlight, bubbles stretch so right alignment works. -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChatMessageItem}">
                        <Grid Margin="0,0,0,12">
                            <!-- The user's question (right) -->
                            <Border Background="#1e3a5f" BorderBrush="#2563eb" BorderThickness="1"
                                    CornerRadius="10,10,2,10" Padding="14,10" MaxWidth="650" HorizontalAlignment="Right"
                                    Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" />
                            </Border>

                            <!-- Answers, notices and errors (left) -->
                            <Border x:Name="ReplyBubble" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10,10,10,2" Padding="14,10" MaxWidth="750" HorizontalAlignment="Left"
                                    Visibility="{Binding IsUser, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" Style="{StaticResource MutedText}" DockPanel.Dock="Right" Margin="12,0,0,0" />
                                        <TextBlock x:Name="ReplyHeader" Text="{Binding Header}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource SuccessBrush}" />
                                    </DockPanel>
                                    <!-- A read-only TextBox so answers can be selected and copied. -->
                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="13"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Sender}" Value="{x:Static vm:ChatSender.Error}">
                                <Setter TargetName="ReplyBubble" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                <Setter TargetName="ReplyHeader" Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Sender}" Value="{x:Static vm:ChatSender.Notice}">
                                <Setter TargetName="ReplyHeader" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Input: Enter sends; while the model answers, the button becomes Cancel -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding InputQuestion, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBox}" IsEnabled="{Binding HasDocument}"
                     ToolTip="Type a question about the document and press Enter"
                     Margin="0,0,8,0" Height="40" VerticalContentAlignment="Center">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SendMessageCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Send ➔" Style="{StaticResource PrimaryButton}" Command="{Binding SendMessageCommand}" Height="40"
                        Visibility="{Binding IsThinking, Converter={StaticResource InverseBoolToVis}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsThinking, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Width="60" Height="4" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Foreground="{StaticResource AccentPrimaryBrush}" Background="{StaticResource BorderBrush}" />
                    <Button Content="✖ Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding SendMessageCancelCommand}" Height="40" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

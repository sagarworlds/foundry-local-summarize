<UserControl x:Class="FoundrySummarizer.Wpf.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:FoundrySummarizer.Wpf.Converters"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Interactive Summary Co-Pilot Chat" Style="{StaticResource HeadingLarge}" />
                <TextBlock Text="Interrogate the generated summary and source document with conversational memory." 
                           Style="{StaticResource BodyText}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="🗑 Clear Session" Style="{StaticResource SecondaryButton}" Command="{Binding ClearChatCommand}" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Quick Question Chips -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Quick Prompts:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="Why was the budget flagged?" Style="{StaticResource SecondaryButton}" Command="{Binding AskPredefinedQuestionCommand}" CommandParameter="Why was the budget expenditure flagged as a risk?" Margin="0,0,6,0" Padding="10,4" FontSize="11" />
                <Button Content="Who is assigned to tasks?" Style="{StaticResource SecondaryButton}" Command="{Binding AskPredefinedQuestionCommand}" CommandParameter="Who are the owners and assignees for the action items?" Margin="0,0,6,0" Padding="10,4" FontSize="11" />
                <Button Content="What are the liability caps?" Style="{StaticResource SecondaryButton}" Command="{Binding AskPredefinedQuestionCommand}" CommandParameter="What are the contract liability caps and policy deviations?" Margin="0,0,6,0" Padding="10,4" FontSize="11" />
            </WrapPanel>
        </Border>

        <!-- Chat Conversation ScrollViewer -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,0,0,12">
            <ListBox ItemsSource="{Binding Messages}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <!-- User Message (Right Aligned) -->
                            <Border Background="#1e3a5f" BorderBrush="#2563eb" BorderThickness="1"
                                    CornerRadius="10,10,2,10" Padding="14,10" MaxWidth="650"
                                    HorizontalAlignment="Right"
                                    Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="You" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="18" />
                                </StackPanel>
                            </Border>

                            <!-- Assistant Message (Left Aligned) -->
                            <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10,10,10,2" Padding="14,10" MaxWidth="750"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Foundry Local Co-Pilot" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" FontSize="11" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" Style="{StaticResource MutedText}" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="19" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Thinking Indicator -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Visibility="{Binding IsThinking, Converter={StaticResource BoolToVis}}" Margin="4,0,0,8">
            <ProgressBar IsIndeterminate="True" Width="80" Height="4" Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,10,0" />
            <TextBlock Text="Foundry Local is processing your follow-up inquiry..." Style="{StaticResource MutedText}" />
        </StackPanel>

        <!-- Message Input Bar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding InputQuestion, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBox}"
                     Tag="Ask a question about the summary or original document..."
                     Margin="0,0,8,0" Height="40" VerticalContentAlignment="Center" />

            <Button Grid.Column="1" Content="Send Inquiry ➔" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SendMessageCommand}" Height="40" />
        </Grid>
    </Grid>
</UserControl>

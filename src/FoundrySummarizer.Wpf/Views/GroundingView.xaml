<UserControl x:Class="FoundrySummarizer.Wpf.Views.GroundingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Semantic Grounding (RAG Policy Knowledge Base)" Style="{StaticResource HeadingLarge}" />
            <TextBlock Text="Indexed with Microsoft.Extensions.VectorData. The AI cross-references summaries against these corporate guidelines to flag budget caps, liability risks, and compliance breaches." 
                       Style="{StaticResource BodyText}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Content Split: Left = Policies & Add, Right = Similarity Search Testing -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Indexed Policies -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Verified Corporate Policies in Vector Store" Style="{StaticResource HeadingMedium}" Margin="0,0,0,10" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding IndexedPolicies}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}" FontSize="13" DockPanel.Dock="Left" />
                                            <Border Background="#1f2937" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="Medium" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Content}" Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DocumentSource, StringFormat='Source: {0}'}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Add New Policy Expander -->
                    <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Add Custom Policy to Vector Store" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Tag="Policy Title" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1" Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Tag="Category" />
                            </Grid>
                            <TextBox Text="{Binding NewContent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Button Content="➕ Embed &amp; Index Policy" Style="{StaticResource PrimaryButton}" Command="{Binding AddPolicyCommand}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Interactive Vector Similarity Query Tester -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Test Vector Similarity Retrieval" Style="{StaticResource HeadingMedium}" Margin="0,0,0,8" />
                    
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,6" />
                        <DockPanel Grid.Row="1">
                            <Button Content="🔍 Compute Cosine Matches" Style="{StaticResource SecondaryButton}" Command="{Binding SearchCommand}" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding SearchStatus}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0" DockPanel.Dock="Right" />
                        </DockPanel>
                    </Grid>

                    <ListBox Grid.Row="2" ItemsSource="{Binding SearchResults}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Record.Title}" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}" FontSize="12" DockPanel.Dock="Left" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                            <Border Background="#064e3b" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding SimilarityScore, StringFormat='Score: {0:P0}'}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="11" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Snippet}" Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

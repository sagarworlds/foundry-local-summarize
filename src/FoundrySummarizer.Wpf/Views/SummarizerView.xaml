<UserControl x:Class="FoundrySummarizer.Wpf.Views.SummarizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:FoundrySummarizer.Wpf.Converters"
             mc:Ignorable="d" d:DesignHeight="650" d:DesignWidth="1080">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Step 1 + 2: open a document, choose a style, summarize -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Style:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Personas}" SelectedItem="{Binding SelectedPersona}" DisplayMemberPath="Name"
                              ToolTip="{Binding SelectedPersona.Description}" Width="210" Height="34" Margin="0,0,12,0" />
                    <Button Content="✨ Summarize" Style="{StaticResource PrimaryButton}" Command="{Binding GenerateSummaryCommand}"
                            Visibility="{Binding GenerateSummaryCommand.IsRunning, Converter={StaticResource InverseBoolToVis}}" />
                    <Button Content="✖ Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding GenerateSummaryCancelCommand}"
                            Visibility="{Binding GenerateSummaryCommand.IsRunning, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <Button Content="📂 Open Document..." Style="{StaticResource SecondaryButton}" Command="{Binding OpenDocumentCommand}"
                        DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,14,0" />

                <StackPanel VerticalAlignment="Center">
                    <!-- Text is set in the style (not locally) so the trigger can replace it while no document is open. -->
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding DocumentName}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DocumentName}" Value="">
                                        <Setter Property="Text" Value="No document open" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding SelectedPersona.Description}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ProgressBar IsIndeterminate="True" Width="90" Height="5" Margin="0,0,12,0" VerticalAlignment="Center"
                             Foreground="{StaticResource AccentPrimaryBrush}" Background="{StaticResource BorderBrush}"
                             Visibility="{Binding GenerateSummaryCommand.IsRunning, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Document text (to check what was extracted) and the summary -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Document Text" Style="{StaticResource HeadingMedium}" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding EstimatedTokens, StringFormat='~{0:N0} tokens'}" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}" />
                    </DockPanel>
                    <TextBox Text="{Binding DocumentText, Mode=OneWay}" IsReadOnly="True"
                             Style="{StaticResource ModernTextBox}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource ModernCard}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Summary" Style="{StaticResource HeadingMedium}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <Button Content="📋 Copy" Style="{StaticResource SecondaryButton}" Command="{Binding CopySummaryCommand}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBox Text="{Binding Summary, Mode=OneWay}" IsReadOnly="True"
                             Style="{StaticResource ModernTextBox}" TextWrapping="Wrap"
                             FontFamily="Consolas, Segoe UI" FontSize="13" VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

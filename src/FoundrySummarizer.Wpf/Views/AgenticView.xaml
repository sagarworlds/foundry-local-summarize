<UserControl x:Class="FoundrySummarizer.Wpf.Views.AgenticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:FoundrySummarizer.Wpf.Converters"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Agentic Workflows &amp; Tool Calling" Style="{StaticResource HeadingLarge}" />
                <TextBlock Text="Semantic Kernel &amp; Microsoft.Extensions.AI tool invocation pipeline (Auto-Filing Agent, SharePoint Archival, Email, Task Tracker)." 
                           Style="{StaticResource BodyText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="⚡ Run Auto-Filing Agent" Style="{StaticResource PrimaryButton}" Command="{Binding RunWorkflowCommand}" Margin="0,0,8,0" />
                <Button Content="🗑 Clear Logs" Style="{StaticResource SecondaryButton}" Command="{Binding ClearLogsCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Status Banner -->
        <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentPrimaryBrush}" FontSize="13" VerticalAlignment="Center" DockPanel.Dock="Left" />
                <ProgressBar IsIndeterminate="{Binding IsRunning}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" 
                             Width="100" Height="6" Foreground="{StaticResource AccentPrimaryBrush}" DockPanel.Dock="Right" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>

        <!-- 4 Step Pipeline Status Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Department Classifier -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="1. Department Categorizer" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding Department}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Tool: DetermineDepartment()" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 2: SharePoint Archival -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="2. Enterprise SharePoint" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding SharePointPath}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Tool: SaveToSharePoint()" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 3: Email Notification -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="3. Stakeholder Email" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding EmailStatus}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Tool: EmailSummary()" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tool Execution Audit Feed -->
        <Border Grid.Row="3" Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Real-Time Function Calling Audit Log" Style="{StaticResource HeadingMedium}" Margin="0,0,0,10" />

                <ListBox Grid.Row="1" ItemsSource="{Binding ExecutionLogs}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <Border Background="#1e293b" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding ToolName}" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" FontSize="12" />
                                            </Border>
                                            <TextBlock Text="{Binding ParametersSummary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" Style="{StaticResource MutedText}" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                    </DockPanel>

                                    <TextBlock Grid.Row="1" Text="{Binding ResultSummary}" Foreground="{StaticResource SuccessBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>

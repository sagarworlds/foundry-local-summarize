<Window x:Class="FoundrySummarizer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:FoundrySummarizer.Wpf.Views"
        mc:Ignorable="d"
        Title="Foundry Local Summarizer"
        Height="680" Width="1080"
        MinHeight="540" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        xmlns:converters="clr-namespace:FoundrySummarizer.Wpf.Converters"
        Background="{StaticResource BgPrimaryBrush}">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title, tabs, Foundry Local status -->
        <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Background="#0284c7" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Foundry Local Summarizer" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <RadioButton Content="✨ Summarize" Style="{StaticResource NavTabButton}" GroupName="NavTabs"
                                 IsChecked="{Binding IsSummarizeTabSelected, Mode=OneWay}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="0" Margin="0,0,6,0" />
                    <RadioButton Content="💬 Chat" Style="{StaticResource NavTabButton}" GroupName="NavTabs"
                                 IsChecked="{Binding IsChatTabSelected, Mode=OneWay}"
                                 Command="{Binding SelectTabCommand}" CommandParameter="1" />
                </StackPanel>

                <!-- Foundry Local: status dot, model picker, status text, refresh -->
                <StackPanel DataContext="{Binding ModelPicker}" Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModelLoading}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsModelReady}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Model:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}"
                              IsEnabled="{Binding CanChangeModel}" Width="290" Height="32" Margin="0,0,10,0"
                              ToolTip="Models downloaded on this PC. Choosing one unloads the current model and loads the new one.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}" />
                                    <TextBlock Text="  ● in memory" Foreground="{StaticResource SuccessBrush}" FontSize="11" VerticalAlignment="Center"
                                               Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" MaxWidth="240"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="↻" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshModelsCommand}"
                            Padding="10,4" FontSize="13" ToolTip="Refresh the model list and load the model (starts Foundry Local if it is not running)" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tab content (headers hidden; the buttons above switch tabs) -->
        <!-- No model loaded: summarizing and chat are disabled until one is -->
        <Border Grid.Row="1" Background="#3b1d1d" BorderBrush="{StaticResource DangerBrush}" BorderThickness="0,0,0,1" Padding="16,8"
                Visibility="{Binding ModelPicker.ShowNotReadyBanner, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button Content="↻ Try Again" Style="{StaticResource SecondaryButton}" Command="{Binding ModelPicker.RefreshModelsCommand}"
                        DockPanel.Dock="Right" Padding="10,4" FontSize="12" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12">
                    <Run Text="No model is loaded, so the app is disabled until one is." FontWeight="SemiBold" />
                    <Run Text="{Binding ModelPicker.StatusText, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Margin="0" Padding="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Style>
            </TabControl.ItemContainerStyle>

            <TabItem Header="Summarize">
                <views:SummarizerView DataContext="{Binding SummarizerVm}" />
            </TabItem>

            <TabItem Header="Chat">
                <views:ChatView DataContext="{Binding ChatVm}" />
            </TabItem>
        </TabControl>

        <!-- Model loading: covers the tabs so nothing can be used until the model is ready -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Background="#CC090d16"
              Visibility="{Binding ModelPicker.IsModelLoading, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource ModernCard}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,24" MinWidth="380">
                <StackPanel>
                    <TextBlock Text="⏳" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding ModelPicker.LoadingText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <ProgressBar IsIndeterminate="True" Height="5" Foreground="{StaticResource AccentPrimaryBrush}" Background="{StaticResource BorderBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

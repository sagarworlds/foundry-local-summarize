<Window x:Class="FoundrySummarizer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:FoundrySummarizer.Wpf.Views"
        xmlns:converters="clr-namespace:FoundrySummarizer.Wpf.Converters"
        mc:Ignorable="d"
        Title="Enterprise AI Summarizer - Microsoft Foundry Local" 
        Height="680" Width="1080"
        MinHeight="540" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:StatusToBrushConverter x:Key="StatusBrush" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP APP HEADER BAR -->
        <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <!-- Title & Ecosystem Subtitle -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="#0284c7" CornerRadius="8" Width="34" Height="34" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Foundry Local Intelligence Summarizer" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="Powered by Microsoft.Extensions.AI &amp; Foundry Local" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </StackPanel>

                <!-- Right Side: Samples + Privacy Mode Switch + Connection Status -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Quick Sample Pickers -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Quick Samples:" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="📄 Meeting" Style="{StaticResource SecondaryButton}" Command="{Binding LoadSampleCommand}" CommandParameter="meeting" Margin="0,0,4,0" Padding="8,4" FontSize="11" />
                        <Button Content="📑 Proposal (.docx)" Style="{StaticResource SecondaryButton}" Command="{Binding LoadSampleCommand}" CommandParameter="proposal" Margin="0,0,4,0" Padding="8,4" FontSize="11" />
                        <Button Content="📜 Contract" Style="{StaticResource SecondaryButton}" Command="{Binding LoadSampleCommand}" CommandParameter="contract" Margin="0,0,4,0" Padding="8,4" FontSize="11" />
                        <Button Content="📊 Deck (.pptx)" Style="{StaticResource SecondaryButton}" Command="{Binding LoadSampleCommand}" CommandParameter="deck" Margin="0,0,4,0" Padding="8,4" FontSize="11" />
                    </StackPanel>

                    <!-- Privacy Mode Toggle Switch -->
                    <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding IsPrivacyMode}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding DaemonStatusText}" Foreground="{Binding DaemonStatusText, Converter={StaticResource StatusBrush}}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Connection Ping Refresh -->
                    <Button Content="↻ Ping" Style="{StaticResource SecondaryButton}" Command="{Binding CheckDaemonStatusCommand}" Padding="8,4" FontSize="11" ToolTip="Ping local Foundry daemon" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- NAVIGATION TABS -->
        <Border Grid.Row="1" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,6">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="📄 Ingestion Pipeline" Style="{StaticResource NavTabButton}" GroupName="NavTabs"
                             IsChecked="{Binding IsTab0Selected, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="0" Margin="0,0,8,0" />
                <RadioButton Content="✨ Persona Summarizer" Style="{StaticResource NavTabButton}" GroupName="NavTabs"
                             IsChecked="{Binding IsTab1Selected, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="1" Margin="0,0,8,0" />
                <RadioButton Content="🧠 Semantic Grounding (RAG)" Style="{StaticResource NavTabButton}" GroupName="NavTabs"
                             IsChecked="{Binding IsTab2Selected, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="2" Margin="0,0,8,0" />
                <RadioButton Content="🤖 Agentic Workflows" Style="{StaticResource NavTabButton}" GroupName="NavTabs"
                             IsChecked="{Binding IsTab3Selected, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="3" Margin="0,0,8,0" />
                <RadioButton Content="💬 Interactive Chat" Style="{StaticResource NavTabButton}" GroupName="NavTabs"
                             IsChecked="{Binding IsTab4Selected, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="4" Margin="0,0,8,0" />
                <RadioButton Content="🛡️ Rigor &amp; Evaluation" Style="{StaticResource NavTabButton}" GroupName="NavTabs"
                             IsChecked="{Binding IsTab5Selected, Mode=OneWay}"
                             Command="{Binding SelectTabCommand}" CommandParameter="5" />
            </StackPanel>
        </Border>

        <!-- MAIN VIEW CONTAINER (Standard TabControl with Hidden Tab Headers) -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Margin="0" Padding="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- Tab 0: Ingestion -->
            <TabItem Header="Ingestion">
                <views:IngestionView DataContext="{Binding IngestionVm}" />
            </TabItem>

            <!-- Tab 1: Persona Summarizer -->
            <TabItem Header="Summarizer">
                <views:SummarizerView DataContext="{Binding SummarizerVm}" />
            </TabItem>

            <!-- Tab 2: Grounding -->
            <TabItem Header="Grounding">
                <views:GroundingView DataContext="{Binding GroundingVm}" />
            </TabItem>

            <!-- Tab 3: Agentic -->
            <TabItem Header="Agentic">
                <views:AgenticView DataContext="{Binding AgenticVm}" />
            </TabItem>

            <!-- Tab 4: Chat -->
            <TabItem Header="Chat">
                <views:ChatView DataContext="{Binding ChatVm}" />
            </TabItem>

            <!-- Tab 5: Evaluation -->
            <TabItem Header="Evaluation">
                <views:EvaluationView DataContext="{Binding EvaluationVm}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>

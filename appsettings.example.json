{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "Foundry": {
    "PrivacyMode": true,
    "EscalateOnComplexity": true,
    "EscalationTokenThreshold": 2500,

    "Local": {
      "Endpoint": "http://localhost:5272/v1",
      "ModelId": "phi-3.5-mini-instruct",
      "TimeoutSeconds": 10,
      "Provider": "FoundryLocal",
      "_comment": "To use Ollama instead, change Endpoint to http://localhost:11434/v1 and ModelId to llama3.2:3b or phi3"
    },

    "Cloud": {
      "Endpoint": "https://models.inference.ai.azure.com",
      "ModelId": "gpt-4o",
      "ApiKey": "YOUR_AZURE_AI_FOUNDRY_OR_OPENAI_KEY_HERE",
      "Provider": "AzureAIFoundry",
      "_comment": "To use OpenAI directly, change Endpoint to https://api.openai.com/v1 and set your API key"
    }
  }
}
